{
  "titleZh": "MySQL 知识地图",
  "intro": "83 个知识点按依赖关系排成五层：先建立直觉，再练 SQL，然后学设计与优化，最后进入生产架构与企业实战。点击任意节点查看通俗讲解，箭头指向它依赖的前置知识。",
  "layers": [
    {
      "id": "foundation",
      "titleZh": "① 建立直觉",
      "description": "先知道 MySQL 是什么、一条 SQL 怎么被执行、表存在哪里，再动手写第一条查询。"
    },
    {
      "id": "sql",
      "titleZh": "② SQL 能力",
      "description": "查询、聚合、多表、写入，以及把数据放进结构合理的表里。"
    },
    {
      "id": "optimize",
      "titleZh": "③ 设计与优化",
      "description": "索引、执行计划、事务与锁：从「能跑」到「跑得快、写得对」。"
    },
    {
      "id": "production",
      "titleZh": "④ 生产与架构",
      "description": "复制、读写分离、分库分表、备份恢复、权限与安全，让数据库扛住真实业务。"
    },
    {
      "id": "enterprise",
      "titleZh": "⑤ 企业实战",
      "description": "电商、库存、订单幂等、报表等真实场景的完整打法与检查清单。"
    }
  ],
