{
  "titleZh": "MySQL 学习知识库",
  "intro": "把 MySQL 从「会用」到「用好」拆成 8 章、83 个知识点：每个知识点都用生活化比喻讲清原理，配可直接运行的 SQL 示例、常见坑和企业落地建议。",
  "layers": [
    { "id": "foundation", "titleZh": "① 建立直觉", "description": "先知道 MySQL 是什么、一条 SQL 怎么被执行、表存在哪里，再动手写第一条查询。" },
    { "id": "sql", "titleZh": "② SQL 能力", "description": "查询、聚合、多表、写入，以及把数据放进结构合理的表里。" },
    { "id": "optimize", "titleZh": "③ 设计与优化", "description": "索引、执行计划、事务与锁：从「能跑」到「跑得快、写得对」。" },
    { "id": "production", "titleZh": "④ 生产与架构", "description": "复制、读写分离、分库分表、备份恢复、权限与安全，让数据库扛住真实业务。" },
    { "id": "enterprise", "titleZh": "⑤ 企业实战", "description": "电商、库存、订单幂等、报表等真实场景的完整打法与检查清单。" }
  ],
  "chapters": [
    {
      "id": "start",
      "titleZh": "入门与心智模型",
      "title": "Getting started",
      "layer": "foundation",
      "icon": "compass",
      "description": "MySQL 是什么、一条 SQL 怎么跑、表怎么存、怎么装怎么连。先建立直觉，后面学语法才不会背完就忘。"
    },
    {
      "id": "sql-basics",
      "titleZh": "SQL 基础",
      "title": "SQL basics",
      "layer": "sql",
      "icon": "code",
      "description": "从 SELECT 到 JOIN 再到子查询，把「查数据」这件事练到不用查手册。"
    },
    {
      "id": "table-design",
      "titleZh": "表设计与数据类型",
      "title": "Table design",
      "layer": "sql",
      "icon": "table",
      "description": "选对类型、设计好主键与约束：表设计做对了，后面一半的坑都不会出现。"
    },
    {
      "id": "index",
      "titleZh": "索引与查询优化",
      "title": "Indexes & optimization",
      "layer": "optimize",
      "icon": "target",
      "description": "索引像书的目录：会用的人让查询快 100 倍，用错的人让写入慢一半。"
    },
    {
      "id": "transaction",
      "titleZh": "事务与并发",
      "title": "Transactions & concurrency",
      "layer": "optimize",
      "icon": "shield",
      "description": "转账为什么不会只扣不贷？并发扣库存为什么会超卖？事务与锁回答这些问题。"
    },
    {
      "id": "architecture",
      "titleZh": "高可用与架构",
      "title": "High availability",
      "layer": "production",
      "icon": "layers",
      "description": "单机 MySQL 撑不住时：主从复制、读写分离、分库分表、备份恢复与在线迁移。"
    },
    {
      "id": "ops-security",
      "titleZh": "运维与安全",
      "title": "Operations & security",
      "layer": "production",
      "icon": "shield",
      "description": "账号权限、SQL 注入、审计、监控与参数调优：数据库上线后每天都要面对的事。"
    },
    {
      "id": "enterprise",
      "titleZh": "企业实战专题",
      "title": "Enterprise scenarios",
      "layer": "enterprise",
      "icon": "spark",
      "description": "把前面所有知识放进真实业务：电商订单、库存超卖、订单幂等、报表统计、数据一致性。"
    }
  ],
